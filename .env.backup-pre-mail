# ---------------------------------------------------------------------------
# HappyKoop application configuration
# ---------------------------------------------------------------------------

# Explicit CORS / Sanctum origins. Comma-separated. Never use a wildcard.
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000

# Canonical storefront URL, used for SEO defaults and payment return URLs.
FRONTEND_URL=http://localhost:3000

# Optional hostname allowlist constraining the admin-editable public URLs
# (activeApiBaseUrl / canonicalFrontendUrl). Empty = allow any valid host.
ALLOWED_PUBLIC_URL_HOSTS=localhost,127.0.0.1

# Sanctum token lifetimes, in minutes.
SANCTUM_CUSTOMER_TOKEN_MINUTES=43200
SANCTUM_ADMIN_TOKEN_MINUTES=720

# Sanctum SPA cookie mode (NOT used by default - see api-contract.md 2.4).
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# Payment provider credentials are NOT configured here. They are entered in
# the admin panel and stored encrypted in the database. These optional vars
# only act as a fallback for local development.
STRIPE_WEBHOOK_TOLERANCE=300

