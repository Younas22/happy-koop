# ---------------------------------------------------------------------------
# HappyKoop backend - LIVE configuration (https://shop.happykoop.be)
#
# On the hosting server: copy this to .env, fill in the blanks, then run
#   php artisan key:generate        (only on first deploy - never change it after,
#                                    it encrypts the payment keys in the database)
#   php artisan migrate --force
#   php artisan storage:link
#   php artisan config:cache && php artisan route:cache
#
# Subdomain document root: point it at /public if the panel allows it.
# Otherwise point it at the project root - the root .htaccess + index.php
# forward everything to /public and block .env, vendor/, storage/, etc.
# ---------------------------------------------------------------------------

APP_NAME=HappyKoop
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://shop.happykoop.be

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="contact@travelbookingpanel.com"
MAIL_FROM_NAME="TravelBookingPanel"
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# HappyKoop application configuration
# ---------------------------------------------------------------------------

# The Vercel storefront. Replace with the real frontend domain(s); add the
# *.vercel.app URL too if you open the site through it.
FRONTEND_URLS=https://happykoop.be,https://www.happykoop.be
FRONTEND_URL=https://happykoop.be

ALLOWED_PUBLIC_URL_HOSTS=shop.happykoop.be,happykoop.be,www.happykoop.be

SANCTUM_CUSTOMER_TOKEN_MINUTES=43200
SANCTUM_ADMIN_TOKEN_MINUTES=720
SANCTUM_STATEFUL_DOMAINS=happykoop.be,www.happykoop.be

STRIPE_WEBHOOK_TOLERANCE=300
