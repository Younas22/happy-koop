# ---------------------------------------------------------------------------
# HappyKoop backend (Laravel) - example configuration
#
# Copy to .env and fill in:   cp .env.example .env && php artisan key:generate
# NEVER commit a real .env file. Every value below is a placeholder.
#
# Payment provider secrets are NOT configured here. An administrator enters
# them in the admin panel; they are stored encrypted at rest using APP_KEY
# and are never returned by any API response.
# ---------------------------------------------------------------------------

APP_NAME=HappyKoop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/happy-koop

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=happykoop
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="contact@travelbookingpanel.com"
MAIL_FROM_NAME="TravelBookingPanel"

# Resend. Backend only: this key must never appear in the Next.js app or in any
# NEXT_PUBLIC_* variable. The sender domain above has to be verified in Resend
# before delivery works - until then, keep MAIL_MAILER=log.
RESEND_API_KEY=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# HappyKoop application configuration
# ---------------------------------------------------------------------------

# Explicit CORS / Sanctum origins. Comma-separated. Never use a wildcard.
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000

# Canonical storefront URL, used for SEO defaults and payment return URLs.
FRONTEND_URL=http://localhost:3000

# Optional hostname allowlist constraining the admin-editable public URLs
# (activeApiBaseUrl / canonicalFrontendUrl). Empty = allow any valid host.
ALLOWED_PUBLIC_URL_HOSTS=localhost,127.0.0.1

# Sanctum token lifetimes, in minutes.
SANCTUM_CUSTOMER_TOKEN_MINUTES=43200
SANCTUM_ADMIN_TOKEN_MINUTES=720

# Sanctum SPA cookie mode (NOT used by default - see api-contract.md 2.4).
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# Payment provider credentials are NOT configured here. They are entered in
# the admin panel and stored encrypted in the database. These optional vars
# only act as a fallback for local development.
STRIPE_WEBHOOK_TOLERANCE=300
